---
import Base from '../layouts/Base.astro';
import StartBlock from '../components/StartBlock.astro';
import { team, situations } from '../data/site';
---
<Base title="Start your mortgage conversation" description="Choose who you would like to work with on the Cristina Acosta Mortgage Team, then book a call, apply online or send a message.">
  <StartBlock title="Choose who you would like to work with, then how you would like to start." lead="Book a conversation, apply online through our brokerage's secure application, or message us on WhatsApp. Every option is free and commits you to nothing." />
  <section class="section-tight msg" aria-labelledby="msg-title">
    <div class="container grid">
      <div>
        <span class="eyebrow">Or send a message</span>
        <h2 id="msg-title">Tell us a little and we will reply the same day.</h2>
        <p class="lead">Three fields. We reply by email or text, whichever you give us, usually within 30 minutes during our hours.</p>
      </div>
      <form class="form" name="contact" method="POST" action="/thanks?for=message" data-netlify="true" netlify-honeypot="company">
        <input type="hidden" name="form-name" value="contact" />
        <p class="hp"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
        <input type="hidden" name="situation" value="" data-situation-field />
        <div class="field"><label for="c-name">Your name</label><input class="input" id="c-name" name="name" required autocomplete="name" /></div>
        <div class="field"><label for="c-contact">Email or mobile</label><input class="input" id="c-contact" name="contact" required autocomplete="email" /></div>
        <div class="field"><span class="label">What is this about?</span>
          <div class="choice">{situations.map((s) => <label><input type="radio" name="topic" value={s.short} /> {s.short}</label>)}<label><input type="radio" name="topic" value="Something else" /> Something else</label></div>
        </div>
        <div class="field"><span class="label">Who should reply?</span>
          <div class="choice">{team.map((p) => <label><input type="radio" name="associate" value={p.first} /> {p.first}</label>)}<label><input type="radio" name="associate" value="Anyone" checked /> Anyone</label></div>
        </div>
        <div class="field"><label for="c-msg">Anything you want us to know <span class="help">(optional)</span></label><textarea class="input" id="c-msg" name="message" rows="4"></textarea></div>
        <label class="consent"><input type="checkbox" name="consent" value="yes" required /><span>I consent to receiving communications from Enrich Mortgage Group, affiliated companies and authorized agents. You can withdraw your consent at any time by unsubscribing. <a href="/privacy">Privacy</a></span></label>
        <button class="btn btn-primary btn-lg" type="submit">Send message</button>
      </form>
    </div>
  </section>
</Base>
<style>
  .msg { background: var(--surface); border-top: var(--hairline); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--s-8); align-items: start; }
  .form { display: grid; gap: var(--s-4); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; gap: var(--s-6); } }
</style>
<script>
  import { situationStore } from '../lib/situation';
  const f = document.querySelector<HTMLInputElement>('[data-situation-field]');
  const labels: Record<string, string> = { first: 'First-time buyers', new: 'New to Canada', self: 'Self-employed', renew: 'Renewal and switch', refi: 'Refinance and equity', invest: 'Investment properties', commercial: 'Commercial' };
  situationStore.subscribe((k) => {
    if (f) f.value = k;
    const radio = document.querySelector<HTMLInputElement>(`input[name="topic"][value="${labels[k] ?? ''}"]`);
    if (radio && !document.querySelector('input[name="topic"]:checked')) radio.checked = true;
  });
</script>
