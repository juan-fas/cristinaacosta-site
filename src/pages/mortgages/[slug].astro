---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import StartBlock from '../../components/StartBlock.astro';
import { situations } from '../../data/situations';
import { situations as sitMeta, team, site, constants } from '../../data/site';

export function getStaticPaths() {
  return situations.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const meta = sitMeta.find((m) => m.key === s.key)!;
const others = sitMeta.filter((m) => m.key !== s.key).slice(0, 3);
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
  { '@type': 'ListItem', position: 2, name: 'Mortgages', item: `${site.url}/mortgages` },
  { '@type': 'ListItem', position: 3, name: meta.short, item: `${site.url}/mortgages/${s.slug}` },
] };
const leadNames = s.leadFirst ?? [];
---
<Base title={s.metaTitle} description={s.description} schema={[faqSchema, crumbs]} brand={false}>
  <!-- QA verify before launch: {s.verify.join(' | ')} -->
  <article data-situation-page={s.key}>
    <header class="head">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/mortgages">Mortgages</a><span aria-hidden="true">/</span><span aria-current="page">{meta.short}</span></nav>
        <span class="eyebrow">{s.eyebrow}</span>
        <h1>{s.title}</h1>
        <p class="lead">{s.intro}</p>
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href={`/start?for=${s.key}`}>Book a conversation</a>
          {s.tool && <a class="btn btn-secondary btn-lg" href={s.tool.href}>{s.tool.label}</a>}
        </div>
      </div>
    </header>

    <section class="section-tight who">
      <div class="container grid2">
        <div>
          <span class="eyebrow">This is for you if</span>
          <ul class="checks">{s.who.map((w) => <li><Icon name="check" size={20} /><span>{w}</span></li>)}</ul>
        </div>
        <div class="tool-card" hidden={!s.tool}>
          {s.tool && <><span class="eyebrow">Try it first</span><h2>{s.tool.label}</h2><p>{s.tool.blurb}</p><a class="btn btn-secondary" href={s.tool.href}>Open the calculator</a>{s.guide && <a class="btn btn-quiet" href={s.guide.href}>{s.guide.label}</a>}</>}
        </div>
      </div>
    </section>

    <section class="section columns">
      <div class="container grid2">
        <div><span class="eyebrow">{s.lenders.h}</span><ol class="numbered">{s.lenders.items.map((i) => <li>{i}</li>)}</ol></div>
        <div><span class="eyebrow">{s.different.h}</span><ol class="numbered accent">{s.different.items.map((i) => <li>{i}</li>)}</ol></div>
      </div>
    </section>

    <section class="section-tight example inverse">
      <div class="container">
        <span class="eyebrow">{s.example.h}</span>
        <div class="ex-grid">
          <div>{s.example.body.map((p) => <p>{p}</p>)}</div>
          <p class="note">{s.example.note} Constants verified {constants.verified}.</p>
        </div>
      </div>
    </section>

    <section class="section docs">
      <div class="container grid2">
        <div>
          <span class="eyebrow">Documents you will need</span>
          <h2>Have these ready and the first meeting does the work of three.</h2>
          <p class="small">Send them through our secure application, never by regular email.</p>
        </div>
        <ul class="doclist">{s.documents.map((d) => <li><Icon name="docs" size={20} /><span>{d}</span></li>)}</ul>
      </div>
    </section>

    <section class="section-tight faqs">
      <div class="container">
        <span class="eyebrow">Questions we hear every week</span>
        <div class="faq-list">
          {s.faqs.map((f, i) => (
            <details name="faq" open={i === 0}>
              <summary><h3>{f.q}</h3><Icon name="plus" size={20} /></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <StartBlock title={`Talk to ${leadNames.length ? leadNames.join(' or ') : 'us'} about your situation.`} lead="A first conversation costs nothing. Bring the questions; we bring the numbers." />

    <section class="section-tight more">
      <div class="container">
        <span class="eyebrow">Other situations</span>
        <div class="more-grid">
          {others.map((o) => <a class="card" href={`/mortgages/${o.slug}`}><Icon name={o.icon} class="ico" /><h3>{o.short}</h3><p>{o.blurb}</p><span class="go">See the steps</span></a>)}
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .head { padding-block: clamp(var(--s-6), 6vw, var(--s-8)) clamp(var(--s-6), 5vw, var(--s-8)); border-bottom: var(--hairline); }
  .head .container { display: grid; gap: var(--s-4); max-width: 860px; margin-inline: auto; }
  .head h1 { font-size: var(--fs-h1); }
  .crumbs { font-size: var(--fs-small); color: var(--text-muted); display: flex; gap: var(--s-2); flex-wrap: wrap; }
  .crumbs a { color: var(--text-muted); text-decoration: none; } .crumbs a:hover { color: var(--accent); }
  .grid2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-8); align-items: start; }
  .checks { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-3); }
  .checks li { display: grid; grid-template-columns: 20px 1fr; gap: var(--s-3); align-items: start; }
  .checks :global(svg) { color: var(--ok); margin-top: 3px; }
  .tool-card { background: var(--surface); border: var(--hairline); padding: var(--s-5); border-radius: var(--radius); display: grid; gap: var(--s-3); justify-items: start; }
  .tool-card h2 { font-size: 1.35rem; }
  .tool-card p { font-size: var(--fs-small); color: var(--text-muted); }
  .columns { border-top: var(--hairline); background: var(--surface); }
  .numbered { list-style: none; padding: 0; margin: 0; counter-reset: n; display: grid; gap: var(--s-4); }
  .numbered li { counter-increment: n; display: grid; grid-template-columns: 36px 1fr; gap: var(--s-3); }
  .numbered li::before { content: counter(n, decimal-leading-zero); font-family: var(--display); font-weight: 600; color: var(--beige-700); font-size: 1rem; padding-top: 2px; }
  .numbered.accent li::before { color: var(--accent); }
  .ex-grid { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: var(--s-6); align-items: end; }
  .ex-grid p { font-size: 1.05rem; }
  .note { font-size: .8rem; color: var(--inverse-muted); }
  .docs h2 { font-size: var(--fs-h3); margin: var(--s-2) 0 var(--s-3); }
  .doclist { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-2); }
  .doclist li { display: grid; grid-template-columns: 20px 1fr; gap: var(--s-3); align-items: start; padding: var(--s-3) 0; border-bottom: var(--hairline); }
  .doclist :global(svg) { color: var(--accent); margin-top: 3px; }
  .faqs { background: var(--surface); border-top: var(--hairline); border-bottom: var(--hairline); }
  .faq-list { display: grid; max-width: 820px; }
  details { border-bottom: var(--hairline); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); padding: var(--s-4) 0; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { font-size: 1.1rem; font-weight: 500; }
  summary :global(svg) { color: var(--accent); flex: none; transition: transform var(--dur-fast) var(--ease); }
  details[open] summary :global(svg) { transform: rotate(45deg); }
  details p { padding: 0 0 var(--s-4); color: var(--text-muted); }
  .more-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); }
  .more-grid h3 { font-size: 1.1rem; font-weight: 600; }
  @media (max-width: 800px) { .grid2, .ex-grid, .more-grid { grid-template-columns: 1fr; gap: var(--s-6); } }
</style>

<script>
  import { situationStore } from '../../lib/situation';
  const key = document.querySelector<HTMLElement>('[data-situation-page]')?.dataset.situationPage;
  if (key) situationStore.set(key);
</script>
