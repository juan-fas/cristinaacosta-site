---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { whatsapp, type Person } from '../data/site';
import cristina from '../assets/photos/cristina.jpg';
import cristinaBw from '../assets/photos/cristina-bw.jpg';
import juan from '../assets/photos/juan.jpg';
import juanBw from '../assets/photos/juan-bw.jpg';
import sheryl from '../assets/photos/sheryl.jpg';
import sherylBw from '../assets/photos/sheryl-bw.jpg';
const photos = { cristina: [cristina, cristinaBw], juan: [juan, juanBw], sheryl: [sheryl, sherylBw] } as const;
interface Props { person: Person; compact?: boolean }
const { person: p, compact = false } = Astro.props;
const [colour, bw] = photos[p.photo];
const alt = `${p.name}, Mortgage Associate`;
---
<article class:list={['person', { compact }]}>
  <a class="ph" href={`/about/${p.slug}`} aria-label={`${p.name}: profile`}>
    <Picture src={bw} formats={['avif', 'webp']} widths={[360, 540, 720]} sizes="(max-width: 600px) 92vw, 30vw" alt="" class="bw" loading="lazy" />
    <Picture src={colour} formats={['avif', 'webp']} widths={[360, 540, 720]} sizes="(max-width: 600px) 92vw, 30vw" alt={alt} class="colour" loading="lazy" />
  </a>
  <div class="body">
    <h3><a href={`/about/${p.slug}`}>{p.name}</a></h3>
    <p class="role">{p.title} · {p.languages.join(', ')}</p>
    {!compact && <p class="focus">{p.focus}</p>}
    <div class="ch">
      {p.booking ? <a class="btn btn-primary btn-sm" href={p.booking} target="_blank" rel="noopener">Book</a> : <a class="btn btn-primary btn-sm" href={`tel:${p.phoneE164}`}>Call</a>}
      <a class="btn btn-wa btn-sm" href={whatsapp(p, `Hi ${p.first}, I found you on cristinaacosta.ca and have a mortgage question.`)} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp</a>
      <a class="btn btn-quiet btn-sm" href={`/about/${p.slug}`}>Profile</a>
    </div>
  </div>
</article>
<style>
  .person { background: var(--surface); border: var(--hairline); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; }
  .ph { position: relative; display: block; aspect-ratio: 2 / 3; background: var(--surface-2); }
  .ph :global(picture), .ph :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .ph :global(.colour) { opacity: 0; transition: opacity var(--dur) var(--ease); }
  .person:hover .ph :global(.colour), .person:focus-within .ph :global(.colour) { opacity: 1; }
  @media (prefers-reduced-motion: reduce), (hover: none) { .ph :global(.colour) { opacity: 1; } }
  .body { padding: var(--s-4) var(--s-4) var(--s-5); display: grid; gap: var(--s-2); }
  h3 { font-size: 1.25rem; font-weight: 600; } h3 a { color: inherit; text-decoration: none; }
  .role { font-size: .8rem; color: var(--text-muted); }
  .focus { font-size: var(--fs-small); color: var(--text-muted); }
  .ch { display: flex; gap: var(--s-2); flex-wrap: wrap; margin-top: var(--s-2); }
  .compact .ph { aspect-ratio: 4 / 5; }
</style>
