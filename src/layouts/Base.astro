---
import '@fontsource/roboto/latin-300.css';
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site, brokerage, team } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'es';
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
  /** Set false on long-tail pages (calculators, guides, situation and person pages) so the
   * title tag stays under ~60 characters instead of always carrying the full brand name. */
  brand?: boolean;
}
const { title, description, lang = 'en', ogImage = '/og/default.png', noindex = false, schema, bodyClass = '', brand = true } = Astro.props;
// The 'file' build format (chosen so Netlify serves clean URLs with no forced trailing slash —
// see astro.config.mjs) means Astro.url.pathname is the literal output filename, e.g.
// "/mortgages/refinance.html". Strip that down to the clean URL Netlify actually serves.
const cleanPath = Astro.url.pathname.replace(/(?:^|\/)index\.html$/, '/').replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(cleanPath, site.url).href;
const canonicalPath = canonical.replace(site.url, '') || '/';
const fullTitle = title.includes('Cristina Acosta') ? title : brand ? `${title} | Cristina Acosta Mortgage Team` : title;
// Reciprocal hreflang only exists for the home page and its true Spanish counterpart /es.
// Every other page has no translated twin yet, so it carries no hreflang at all rather than a false one.
const isTranslatedPair = canonicalPath === '/' || canonicalPath === '/es';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  '@id': `${site.url}/#org`,
  name: site.name,
  url: site.url,
  email: site.email,
  image: `${site.url}/og/default.png`,
  logo: `${site.url}/apple-touch-icon.png`,
  parentOrganization: { '@type': 'Organization', name: brokerage.name },
  address: { '@type': 'PostalAddress', streetAddress: brokerage.address.line1, addressLocality: brokerage.address.city, addressRegion: brokerage.address.provinceCode, postalCode: brokerage.address.postal, addressCountry: 'CA' },
  hasMap: brokerage.address.mapsUrl,
  // Calgary is where the team practises today; Edmonton is a stated goal, not yet backed by
  // any Edmonton-specific content, so it stays out of this claim until that content exists.
  areaServed: ['Calgary', 'Alberta'],
  knowsLanguage: ['en', 'es'],
  openingHoursSpecification: site.openingHours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens: h.opens, closes: h.closes })),
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', email: site.email, availableLanguage: ['English', 'Spanish'] },
  employee: team.map((p) => ({ '@type': 'Person', name: p.name, jobTitle: p.title, url: `${site.url}/about/${p.slug}`, telephone: p.phoneE164, email: p.email })),
  sameAs: Object.values(site.social),
};
const schemas = [orgSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang={lang === 'es' ? 'es-CA' : 'en-CA'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/gigasans-semibold.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CA' : 'en_CA'} />
    <meta name="twitter:card" content="summary_large_image" />
    {isTranslatedPair && (
      <>
        <link rel="alternate" hreflang="en-CA" href={`${site.url}/`} />
        <link rel="alternate" hreflang="es-CA" href={`${site.url}/es`} />
        <link rel="alternate" hreflang="x-default" href={`${site.url}/`} />
      </>
    )}
    <meta name="theme-color" content="#F4EFE9" />
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      // Reveal-on-scroll: sections are visible at rest; JS only adds the entrance.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => {
        // Anything already on screen shows at once; the rest animates in on scroll.
        if (el.getBoundingClientRect().top < innerHeight) el.classList.add('in'); else io.observe(el);
      });
      // Safety net: never leave content hidden if the observer does not fire.
      setTimeout(() => document.querySelectorAll('.reveal:not(.in)').forEach((el) => el.classList.add('in')), 4000);
    </script>
  </body>
</html>
